{
  "extends": "./tsconfig.json",
  // `exclude` replaces the inherited list; keep shared entries in sync with tsconfig.json.
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/src",
    "packages/docs",
    "openclaw",
    "e2e",
    "render-service",
    "tests",
    "eval",
    "packages/@openmaic/*/test",
    // Operator scripts are run by hand against a configured machine
    // (model probes, provider sweeps, build tweaks). None of them ship in the
    // bundle, and tsconfig.json's `**/*.ts` pulled them into the production
    // typecheck — so a diagnostic helper could block a deploy over a type it
    // never uses at runtime. They keep the strict check in `pnpm typecheck`
    // via tsconfig.json; only the deploy-time check skips them.
    "scripts"
  ]
}
